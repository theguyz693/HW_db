# ──────────────────────────────────────────────
# CollectorHub Backend — Environment Variables
# ──────────────────────────────────────────────

# Server
PORT=4000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://collectorhub:collectorhub_dev@localhost:27017/collectorhub?authSource=admin

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# CORS
CORS_ORIGIN=http://localhost:5173

# Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# Cloudinary (future)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
